# ------------------------------------------------------------------
# Copy this file to ".env.local" and fill in the values (see SETUP.md).
# .env.local is private: it is never uploaded to GitHub.
# ------------------------------------------------------------------

# --- Supabase (Project Settings → API Keys / Data API) ---
# These two are PUBLIC by design (safe in the browser; RLS protects data).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# SECRET — server only. Never share it, never put NEXT_PUBLIC_ in front of it.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# --- Admin ---
# Must be exactly the email of Hitesh's admin login.
ADMIN_EMAIL=you@example.com
